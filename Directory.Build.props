<Project>

  <!-- Settings shared by every project in this folder. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Microsoft's recommended code analysis rules, and the code style rules in .editorconfig, are checked on every build. -->
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Company>MFG Manager</Company>
    <Product>MFG Manager</Product>
    <Version>2.0.5</Version>
  </PropertyGroup>

  <!-- Debug information holds the build computer's folder paths, which would end up in the files people download. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
