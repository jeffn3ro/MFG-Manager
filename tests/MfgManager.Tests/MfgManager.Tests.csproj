<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests. Run them with:  dotnet test -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051 wants every test to pass a cancel token around; these tests are short and use a fake web, so it adds only noise. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Tests that draw share one app and its light/dark setting, so tests run one at a time. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MfgManager.Core\MfgManager.Core.csproj" />
    <ProjectReference Include="..\..\src\MfgManager.App\MfgManager.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.5" />
    <!-- Keeps Avalonia's build telemetry out of this project too; see MfgManager.App.csproj. -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

</Project>
