<!-- The left column: the logo, the launcher and DRM lists, then which mod is used and light or dark at the bottom. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MfgManager.App.ViewModels"
             xmlns:sidebar="using:MfgManager.App.Components.Sidebar"
             x:Class="MfgManager.App.Components.Sidebar.Sidebar"
             x:DataType="vm:MainViewModel">
  <Border Classes="panel" BorderThickness="0,0,1,0">
    <DockPanel Margin="12,14">

      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="4,0,0,16">
        <Image Source="/Assets/logo.png" Width="36" Height="36" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="MFG Manager" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Classes="label" Text="{Binding VersionText}" />
        </StackPanel>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,12,0,0">
        <sidebar:ModCard DataContext="{Binding Mod}" />
        <sidebar:ThemePicker />
      </StackPanel>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
          <sidebar:FilterList Title="LIBRARY"
                              Options="{Binding Library.LauncherOptions}"
                              Selected="{Binding Library.SelectedLauncherOption}" />
          <sidebar:FilterList Title="DRM"
                              Options="{Binding Library.DrmOptions}"
                              Selected="{Binding Library.SelectedDrmOption}" />
        </StackPanel>
      </ScrollViewer>

    </DockPanel>
  </Border>
</UserControl>
