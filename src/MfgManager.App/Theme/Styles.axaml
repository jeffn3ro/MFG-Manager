<!--
    How things look. Selectors work like CSS: "Button.accent" is a Button with Classes="accent".
    Colours come from Colors.axaml, so everything here works in both light and dark mode.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Window and text ===== -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="fonts:Inter#Inter, $Default" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.sectionLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Avalonia keeps the normal text colour on the highlight, which was unreadable in both modes. -->
  <Style Selector="TextBox">
    <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource OnTextSelectionBrush}" />
  </Style>

  <!-- ===== Panels ===== -->

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>

  <!-- ===== The main button: gold-to-lime, near-black text in both modes ===== -->

  <Style Selector="Button.accent">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentDisabledBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentDisabledBrush}" />
  </Style>

  <!-- ===== Small labels: "Installed", "Anti-cheat", DRM names ===== -->

  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="Background" Value="{DynamicResource NeutralBackBrush}" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NeutralTextBrush}" />
  </Style>
  <Style Selector="Border.pill.success"><Setter Property="Background" Value="{DynamicResource SuccessBackBrush}" /></Style>
  <Style Selector="Border.pill.success > TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" /></Style>
  <Style Selector="Border.pill.info"><Setter Property="Background" Value="{DynamicResource InfoBackBrush}" /></Style>
  <Style Selector="Border.pill.info > TextBlock"><Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}" /></Style>
  <Style Selector="Border.pill.warning"><Setter Property="Background" Value="{DynamicResource WarningBackBrush}" /></Style>
  <Style Selector="Border.pill.warning > TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" /></Style>
  <Style Selector="Border.pill.danger"><Setter Property="Background" Value="{DynamicResource DangerBackBrush}" /></Style>
  <Style Selector="Border.pill.danger > TextBlock"><Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" /></Style>

  <!-- ===== Banners: a coloured strip with a message and buttons ===== -->

  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Border.banner TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.banner.info"><Setter Property="Background" Value="{DynamicResource InfoBackBrush}" /></Style>
  <Style Selector="Border.banner.info TextBlock"><Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}" /></Style>
  <Style Selector="Border.banner.warning"><Setter Property="Background" Value="{DynamicResource WarningBackBrush}" /></Style>
  <Style Selector="Border.banner.warning TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" /></Style>
  <Style Selector="Border.banner.danger"><Setter Property="Background" Value="{DynamicResource DangerBackBrush}" /></Style>
  <Style Selector="Border.banner.danger TextBlock"><Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" /></Style>
  <!-- A button inside a banner keeps its own text colour. -->
  <Style Selector="Border.banner Button TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
  </Style>

  <!-- The coloured stripe on a pop-up message -->
  <Style Selector="Border.marker.info"><Setter Property="Background" Value="{DynamicResource InfoTextBrush}" /></Style>
  <Style Selector="Border.marker.warning"><Setter Property="Background" Value="{DynamicResource WarningTextBrush}" /></Style>
  <Style Selector="Border.marker.danger"><Setter Property="Background" Value="{DynamicResource DangerTextBrush}" /></Style>

  <!-- ===== A game card ===== -->

  <Style Selector="Button.card">
    <Setter Property="Padding" Value="6" />
    <!-- Fill the row, so covers line up when one game in the row has a longer name. -->
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.card /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.card.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.card.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.card.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ===== The sidebar's lists ===== -->

  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

</Styles>
